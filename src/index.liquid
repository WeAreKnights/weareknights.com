---
layout: layouts/base.liquid
title: Home
---
<section class="hero">
  <h1>We Are Knights</h1>
  <p>A two-person design studio run by Mitchell Knight and Tonya Knight. We build brand identities, web products, and print work that holds up over time.</p>
</section>

<section class="reveal">
  <h2>Recent work</h2>
  <div class="grid">
    {% assign recent = collections.portfolio | reverse | slice: 0, 3 %}
    {% for item in recent %}
    <div class="card reveal reveal-item" style="--reveal-index: {{ forloop.index0 }}">
      <a href="{{ item.url }}">
        {% if item.data.image %}<img src="{{ item.data.image }}" alt="{{ item.data.title }}">{% endif %}
        <div class="card-body">
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.category }}</p>
        </div>
      </a>
    </div>
    {% endfor %}
  </div>
  <p><a href="/portfolio/">View the full portfolio &rarr;</a></p>
</section>

<section class="reveal">
  <h2>From the blog</h2>
  <ul class="post-list">
    {% assign recentPosts = collections.posts | slice: 0, 3 %}
    {% for post in recentPosts %}
    <li class="post-list-item reveal reveal-item" style="--reveal-index: {{ forloop.index0 }}">
      {% if post.data.image %}
      <a href="{{ post.url }}"><img class="post-thumb" src="{{ post.data.image }}" alt="{{ post.data.title }}"></a>
      {% endif %}
      <div class="post-list-item-body">
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p class="post-meta">
          <time datetime="{{ post.data.date | htmlDateString }}">{{ post.data.date | readableDate }}</time>
        </p>
      </div>
    </li>
    {% endfor %}
  </ul>
  <p><a href="/blog/">Read the blog &rarr;</a></p>
</section>

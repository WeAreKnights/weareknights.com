---
layout: page.liquid
pagination:
  data: authors
  size: 1
  alias: author
permalink: "/designers/{{ author.id }}/"
fullWidth: true
eleventyComputed:
  title: "{{ author.name }}"
  description: "{{ author.bio }}"
---

<section class="content">
	{% assign intro = author.about | default: author.bio %}
	{% assign sentences = intro | split: ". " %}
	{% if sentences.size > 1 %}
		<p class="lead">{{ sentences | first }}.</p>
		<p>{{ sentences | slice: 1, sentences.size | join: ". " }}</p>
	{% else %}
		<p class="lead">{{ intro }}</p>
	{% endif %}
	{% include "components/author/author-links.liquid" %}
</section>

{% if author.clients.size > 0 %}
	<section class="container">
		<h2>Brands</h2>
		{% include "components/client-logos/client-logos.liquid", clients: author.clients %}
	</section>
{% endif %}

{% assign authorProjects = collections.portfolioProjects | where: "data.designer", author.id %}
{% if authorProjects.size > 0 %}
	<section class="container">
		<h2>Portfolio</h2>
		{% assign recentProjects = authorProjects | reverse | slice: 0, 4 %}
		{% include "components/portfolio/portfolio.liquid", items: recentProjects, isFilterable: true %}
		<p><a class="button button-outline" href="/portfolio/?designer={{ author.id }}">View Full Portfolio</a></p>
	</section>
{% endif %}

{% assign authorPosts = collections.posts | reverse | where: "data.author", author.id %}
{% if authorPosts.size > 0 %}
	<section class="content">
		<h2>Blog posts</h2>
		{% include "components/post-list/post-list.liquid", posts: authorPosts, headingLevel: 3 %}
	</section>
{% endif %}

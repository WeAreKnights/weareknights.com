---
layout: layouts/base.liquid
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | slugify }}/"
eleventyComputed:
  title: "Tag: {{ tag }}"
---
<h1>Tag: #{{ tag }}</h1>

{% assign tagPosts = "" | split: "" %}
{% for post in collections.posts %}
  {% if post.data.tags contains tag %}
    {% assign tagPosts = tagPosts | push: post %}
  {% endif %}
{% endfor %}
{% include "partials/blog-index.liquid", posts: tagPosts %}

<p><a href="/blog/">&larr; Back to all posts</a></p>

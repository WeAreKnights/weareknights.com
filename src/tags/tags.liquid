---
layout: layouts/base.liquid
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | slugify }}/"
eleventyComputed:
  title: "Tag: {{ tag }}"
---
<h1>Tag: #{{ tag }}</h1>

<ul class="post-list">
  {% assign revealIndex = -1 %}
  {% for post in collections.posts %}
    {% if post.data.tags contains tag %}
    {% assign revealIndex = revealIndex | plus: 1 %}
    <li class="post-list-item reveal reveal-item" style="--reveal-index: {{ revealIndex }}">
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p class="post-meta">
        <time datetime="{{ post.data.date | htmlDateString }}">{{ post.data.date | readableDate }}</time>
      </p>
      {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
    </li>
    {% endif %}
  {% endfor %}
</ul>

<p><a href="/blog/">&larr; Back to all posts</a></p>

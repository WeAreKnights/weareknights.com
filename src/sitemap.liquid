---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}
	{% unless item.data.noindex or item.data.page.outputFileExtension != "html" %}
	<url>
		<loc>{{ item.url | absoluteUrl: site.url }}</loc>
		{% assign lastmod = item.data.modified | default: item.data.date %}
		{% if lastmod %}<lastmod>{{ lastmod | isoDate }}</lastmod>{% endif %}
	</url>
	{% endunless %}
{% endfor %}
</urlset>

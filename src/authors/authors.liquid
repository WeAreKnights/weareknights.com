---
layout: layouts/base.liquid
pagination:
  data: authors
  size: 1
  alias: author
permalink: "/authors/{{ author.id }}/"
eleventyComputed:
  title: "{{ author.name }}"
---
<h1>{{ author.name }}</h1>
<p>{{ author.bio }}</p>

<ul class="post-list">
  {% for post in collections.posts %}
    {% if post.data.post_author == author.id %}
    <li class="post-list-item">
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p class="post-meta">
        <time datetime="{{ post.data.date | htmlDateString }}">{{ post.data.date | readableDate }}</time>
      </p>
      {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
    </li>
    {% endif %}
  {% endfor %}
</ul>

<p><a href="/blog/">&larr; Back to all posts</a></p>

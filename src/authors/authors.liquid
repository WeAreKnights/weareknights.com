---
layout: layouts/base.liquid
pagination:
  data: authors
  size: 1
  alias: author
permalink: "/authors/{{ author.id }}/"
eleventyComputed:
  title: "{{ author.name }}"
  description: "{{ author.bio }}"
---
<h1>{{ author.name }}</h1>
<p>{{ author.bio }}</p>

{% if author.social %}
<ul class="social-links reveal">
  {% for link in author.social %}
  <li>
    <a class="social-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
      {% if link.platform == "github" %}
      <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
      </svg>
      {% elsif link.platform == "dribbble" %}
      <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72M19.13 5.09C15.41 9.44 10.19 10.76 2.25 10.75M21.75 12.83c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"></path>
      </svg>
      {% endif %}
      <span>{{ link.label }}</span>
    </a>
  </li>
  {% endfor %}
</ul>
{% endif %}

{% assign authorPortfolio = "" | split: "" %}
{% for item in collections.portfolio %}
  {% if item.data.designer == author.id %}
    {% assign authorPortfolio = authorPortfolio | push: item %}
  {% endif %}
{% endfor %}
{% assign recentAuthorPortfolio = authorPortfolio | slice: 0, 4 %}

{% if recentAuthorPortfolio.size > 0 %}
<section class="reveal">
  <h2>Portfolio</h2>

  {% assign authorCategories = "" | split: "" %}
  {% for item in recentAuthorPortfolio %}
    {% unless authorCategories contains item.data.category %}
      {% assign authorCategories = authorCategories | push: item.data.category %}
    {% endunless %}
  {% endfor %}

  {% if authorCategories.size > 1 %}
  <div class="filter-bar reveal">
    <div class="filter-group" data-filter-group="category">
      <span>Category</span>
      <button type="button" class="filter-btn" data-filter-value="all" aria-pressed="true">All</button>
      {% for category in authorCategories %}
      <button type="button" class="filter-btn" data-filter-value="{{ category | slugify }}" aria-pressed="false">{{ category }}</button>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="grid">
    {% for item in recentAuthorPortfolio %}
    <div class="card portfolio-item reveal reveal-item" data-designer="{{ item.data.designer }}" data-category="{{ item.data.category | slugify }}" style="--reveal-index: {{ forloop.index0 }}">
      <a href="{{ item.url }}">
        {% if item.data.image %}<img src="{{ item.data.image }}" alt="{{ item.data.title }}">{% endif %}
        <div class="card-body">
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.category }}</p>
        </div>
      </a>
    </div>
    {% endfor %}
  </div>

  <p><a href="/portfolio/?designer={{ author.id }}">View all portfolio pieces by {{ author.name }} &rarr;</a></p>
</section>

<script src="/js/portfolio-filter.js"></script>
{% endif %}

<h2>Blog Posts</h2>

<ul class="post-list">
  {% assign revealIndex = -1 %}
  {% for post in collections.posts %}
    {% if post.data.post_author == author.id %}
    {% assign revealIndex = revealIndex | plus: 1 %}
    {% include "post-list-item.liquid", post: post, revealIndex: revealIndex %}
    {% endif %}
  {% endfor %}
</ul>

<p><a href="/blog/">&larr; Back to all posts</a></p>

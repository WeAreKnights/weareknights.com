<div class="portfolio-grid">
  {% for item in items %}
  <div class="portfolio-tile portfolio-item reveal reveal-item" data-designer="{{ item.data.designer }}" data-category="{{ item.data.category | slugify }}" style="--reveal-index: {{ forloop.index0 }}">
    <a href="{{ item.url }}">
      {% if item.data.image %}<img src="{{ item.data.image }}" alt="{{ item.data.title }}">{% endif %}
      <div class="tile-overlay">
        <h3>{{ item.data.title }}</h3>
        <p>{{ item.data.category }}</p>
      </div>
    </a>
  </div>
  {% endfor %}
</div>

{% assign gtagId = site.googleAnalyticsId %}
{% if gtagId == "" %}{% assign gtagId = site.googleAdsId %}{% endif %}
{% assign adsConversion = false %}
{% if site.googleAdsId != "" and site.googleAdsConversion != "" %}{% assign adsConversion = true %}{% endif %}
{% if gtagId != "" %}
<link rel="preconnect" href="https://www.googletagmanager.com">
{% if site.googleAnalyticsId != "" %}<link rel="preconnect" href="https://www.google-analytics.com">{% endif %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ gtagId }}"></script>
<script>
	window.dataLayer = window.dataLayer || [];
	function gtag() { dataLayer.push(arguments); }
	gtag("js", new Date());
	{% if site.googleAnalyticsId != "" %}gtag("config", "{{ site.googleAnalyticsId }}");{% endif %}
	{% if site.googleAdsId != "" %}gtag("config", "{{ site.googleAdsId }}");{% endif %}
</script>
{% endif %}
{% if site.metaPixelId != "" %}
<script>
	!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");
	fbq("init", "{{ site.metaPixelId }}");
	fbq("track", "PageView");
</script>
{% endif %}
{% if adsConversion or site.metaPixelId != "" %}
<script>
	window.trackConversion = function () {
		{% if adsConversion %}gtag("event", "conversion", { send_to: "{{ site.googleAdsConversion }}" });{% endif %}
		{% if site.metaPixelId != "" %}fbq("track", "Lead");{% endif %}
	};
	{% if conversion %}window.trackConversion();{% endif %}
</script>
{% endif %}

<!doctype html>
<html lang="en">
<head>
	<script>document.documentElement.classList.add("js")</script>
	{% include "partials/head.liquid" %}
</head>
<body>
	<a class="skip-link" href="#main-content">Skip to content</a>
	{% include "components/header/header.liquid" %}
	{% assign hasSidebar = false %}
	{% assign sidebarHtml = "" | sidebarContent %}
	{% if sidebar == "left" or sidebar == "right" %}
		{% if sidebarHtml != "" %}
			{% unless fullWidth %}{% assign hasSidebar = true %}{% endunless %}
		{% endif %}
	{% endif %}
	{% if hasSidebar %}<div class="has-sidebar has-sidebar-{{ sidebar }}">{% endif %}
	<main id="main-content"{% unless noindex %} data-pagefind-body{% endunless %}>
		{{ content }}
	</main>
	{% if hasSidebar %}
	{% include "components/sidebar/sidebar.liquid" %}
	</div>
	{% endif %}
	{% include "partials/footer.liquid" %}
	<script type="module" src="{{ manifest.js }}"></script>
</body>
</html>

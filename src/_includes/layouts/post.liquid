---
layout: base.liquid
---

{% include "components/hero/hero.liquid", showDate: true %}
{% assign pageTitle = title | default: site.title %}
{% postBreadcrumbSchema site, pageTitle, page.url %}
{% blogPostingSchema site, pageTitle, description, image, page.url, date, modified %}
{% assign postAuthor = authors | where: "id", author | first %}
<article{% unless fullWidth %} class="content"{% endunless %}>
	{% if postAuthor %}<p class="author-byline">By <a href="/designers/{{ postAuthor.id }}/">{{ postAuthor.name }}</a></p>{% endif %}
	{{ content }}
</article>

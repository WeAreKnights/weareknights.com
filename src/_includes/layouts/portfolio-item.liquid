---
layout: base.liquid
---

{% include "components/hero/hero.liquid" %}
{% assign pageTitle = title | default: site.title %}
{% pageBreadcrumbSchema site, pageTitle, page.url %}
{% assign projectDesigner = authors | where: "id", designer | first %}
<article class="container">
	{{ content }}
	{% assign projectImages = images %}
	{% if projectImages == nil and image %}{% assign projectImages = image | split: "," %}{% endif %}
	{% if projectImages.size > 0 %}
		<div class="portfolio-images">
			{% for projectImage in projectImages %}
				{% assign imagePath = projectImage.src | default: projectImage %}
				{% if projectImage.caption %}
					{% assign imageAlt = title | append: ": " | append: projectImage.caption %}
				{% else %}
					{% assign imageAlt = title | append: " (" | append: forloop.index | append: " of " | append: forloop.length | append: ")" %}
				{% endif %}
				<figure>
					{% responsiveImage imagePath, imageAlt, "(min-width: 1200px) 1200px, 100vw" %}
					{% if projectImage.caption %}<figcaption>{{ projectImage.caption }}</figcaption>{% endif %}
				</figure>
			{% endfor %}
		</div>
	{% endif %}
	{% if credits.size > 0 or projectDesigner or category %}
		<section class="portfolio-credits">
			<h2>Credits</h2>
			<ul>
				{% if projectDesigner %}
					<li>
						<span class="portfolio-credit-role">Designer</span>
						<a href="/designers/{{ projectDesigner.id }}/">{{ projectDesigner.name }}</a>
					</li>
				{% endif %}
				{% if category %}
					<li>
						<span class="portfolio-credit-role">Category</span>
						<a href="/portfolio/?category={{ category | slugify }}">{{ category }}</a>
					</li>
				{% endif %}
				{% for credit in credits %}
					<li>
						<span class="portfolio-credit-role">{{ credit.role }}</span>
						{% if credit.url %}<a href="{{ credit.url }}" target="_blank" rel="noopener noreferrer">{{ credit.name }}<span class="visually-hidden"> (opens in a new tab)</span></a>{% else %}{{ credit.name }}{% endif %}
					</li>
				{% endfor %}
			</ul>
		</section>
	{% endif %}
	<p><a class="button button-outline" href="/portfolio/">Back to Portfolio</a></p>
</article>

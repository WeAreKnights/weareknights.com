---
layout: layouts/base.liquid
---
{% assign designerRecord = authors | getAuthor: designer %}
<article class="portfolio-detail">
  <h1>{{ title }}</h1>
  <p class="post-meta">
    {{ category }}
    {% if designerRecord %} · <a href="/authors/{{ designerRecord.id }}/">{{ designerRecord.name }}</a>{% endif %}
  </p>
  {% if image %}<img src="{{ image }}" alt="{{ title }}">{% endif %}
  <div class="post-content">
    {{ content }}
  </div>

  {% if credits %}
  <section class="credits">
    <h2>Credits</h2>
    <ul class="credits-list">
      {% for credit in credits %}
      <li>
        <span class="credit-role">{{ credit.role }}</span>
        {% if credit.url %}
          <a href="{{ credit.url }}" target="_blank" rel="noopener noreferrer">{{ credit.name }}</a>
        {% else %}
          <span class="credit-name">{{ credit.name }}</span>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <p><a href="/portfolio/">&larr; Back to portfolio</a></p>
</article>

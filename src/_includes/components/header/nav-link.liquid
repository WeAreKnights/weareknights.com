{% if link.external %}
	<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
		{{ link.label }}
		<span class="visually-hidden">(opens in a new tab)</span>
	</a>
{% else %}
	<a href="{{ link.url }}" {% if link.url == page.url %}aria-current="page"{% endif %}>{{ link.label }}</a>
{% endif %}

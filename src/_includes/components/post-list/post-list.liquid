{% assign headingTag = headingLevel | default: 2 | prepend: "h" %}
<ul class="post-list">
	{% for post in posts %}
		<li class="post-list-item">
			{% if post.data.image %}
				<a href="{{ post.url }}" class="post-list-image">{% responsiveImage post.data.image, post.data.title %}</a>
			{% endif %}
			<{{ headingTag }} class="post-list-title"><a href="{{ post.url }}">{{ post.data.title }}</a></{{ headingTag }}>
			{% assign snippet = post.data.excerpt | default: post.data.description %}
			{% if snippet %}<p class="post-list-excerpt">{{ snippet | truncatewords: 30 }}</p>{% endif %}
			{% include "components/post-meta/post-meta.liquid", authorId: post.data.author, tags: post.data.tags, date: post.date %}
		</li>
	{% endfor %}
</ul>

<header class="hero" {% if image and video == blank %}style="background-image: url('{{ image }}')"{% endif %}>
	{% if video %}
		<div class="video-background" aria-hidden="true">
			<iframe src="{{ video | videoEmbedUrl: true }}" title="Background video" tabindex="-1" allow="autoplay"></iframe>
		</div>
	{% endif %}
	<div class="hero-inner">
		<h1>{{ title | default: site.title }}</h1>
		{% if showMeta %}
			{% include "components/post-meta/post-meta.liquid", authorId: author, tags: tags, date: date %}
		{% endif %}
	</div>
</header>

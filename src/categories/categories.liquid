---
layout: layouts/base.liquid
pagination:
  data: collections.categoryList
  size: 1
  alias: category
permalink: "/categories/{{ category | slugify }}/"
eleventyComputed:
  title: "Category: {{ category }}"
---
<h1>Category: {{ category }}</h1>

{% assign categoryPosts = "" | split: "" %}
{% for post in collections.posts %}
  {% if post.data.categories contains category %}
    {% assign categoryPosts = categoryPosts | push: post %}
  {% endif %}
{% endfor %}
{% include "blog-index.liquid", posts: categoryPosts %}

<p><a href="/blog/">&larr; Back to all posts</a></p>
